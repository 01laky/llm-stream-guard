{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/01laky/llm-stream-guard/schemas/policy-v1.json",
	"title": "llm-stream-guard policy v1",
	"type": "object",
	"required": ["version"],
	"properties": {
		"version": { "const": "1" },
		"policyVersion": { "type": "string" },
		"extends": { "type": "string" },
		"mode": { "enum": ["block", "warn", "audit"] },
		"byte": {
			"type": "object",
			"properties": {
				"redactSecrets": { "type": "boolean" },
				"sanitizeErrors": { "type": "boolean" }
			},
			"additionalProperties": false
		},
		"rules": {
			"type": "array",
			"items": {
				"oneOf": [
					{
						"type": "object",
						"required": ["redactSecrets"],
						"properties": { "redactSecrets": { "type": "object" } },
						"additionalProperties": false
					},
					{
						"type": "object",
						"required": ["redactPII"],
						"properties": {
							"redactPII": {
								"type": "object",
								"properties": { "email": { "type": "boolean" }, "phone": { "type": "boolean" } }
							}
						},
						"additionalProperties": false
					},
					{
						"type": "object",
						"required": ["allowTools"],
						"properties": {
							"allowTools": {
								"type": "object",
								"required": ["names"],
								"properties": { "names": { "type": "array", "items": { "type": "string" } } }
							}
						},
						"additionalProperties": false
					},
					{
						"type": "object",
						"required": ["denyTools"],
						"properties": {
							"denyTools": {
								"type": "object",
								"required": ["names"],
								"properties": { "names": { "type": "array", "items": { "type": "string" } } }
							}
						},
						"additionalProperties": false
					},
					{
						"type": "object",
						"required": ["blockToolArgs"],
						"properties": { "blockToolArgs": { "type": "object" } },
						"additionalProperties": false
					},
					{
						"type": "object",
						"required": ["maxToolArgsBytes"],
						"properties": {
							"maxToolArgsBytes": {
								"type": "object",
								"required": ["max"],
								"properties": { "max": { "type": "integer", "minimum": 1 } }
							}
						},
						"additionalProperties": false
					},
					{
						"type": "object",
						"required": ["sanitizeErrors"],
						"properties": { "sanitizeErrors": { "type": "object" } },
						"additionalProperties": false
					}
				]
			}
		}
	},
	"additionalProperties": false
}
