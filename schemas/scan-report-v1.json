{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/01laky/llm-stream-guard/schemas/scan-report-v1.json",
	"title": "llm-stream-guard scan report v1",
	"type": "object",
	"required": ["summary", "violations"],
	"additionalProperties": false,
	"properties": {
		"summary": {
			"type": "object",
			"required": ["files", "violations", "redactions", "mode"],
			"additionalProperties": false,
			"properties": {
				"files": { "type": "integer", "minimum": 0 },
				"violations": { "type": "integer", "minimum": 0 },
				"redactions": { "type": "integer", "minimum": 0 },
				"mode": { "type": "string" },
				"policyVersion": { "type": "string" }
			}
		},
		"violations": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["file", "rule", "message", "mode"],
				"additionalProperties": false,
				"properties": {
					"file": { "type": "string" },
					"rule": { "type": "string" },
					"message": { "type": "string" },
					"mode": { "type": "string" },
					"policyVersion": { "type": "string" }
				}
			}
		}
	}
}
